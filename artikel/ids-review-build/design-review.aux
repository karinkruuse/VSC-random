\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Calculated carrier and first-order sideband readout noise for the stated bright-beam operating point. The model uses a $50\,\Omega $ load at $300\,\mathrm  K$, $100\,\mathrm  {nA}$ dark current, and white fractional intensity noise of $9\times 10^{-9}/\sqrt  {\mathrm  {Hz}}$, with the two beams' additive intensity noise summed coherently. The assumed current-to-voltage gain at each ADC is $50/\sqrt  {3}\,\mathrm  {V/A}$, with a $1\,\mathrm  V$ full-scale span, 14 bits and $2\,\mathrm  {GS/s}$. The ADC curve is ideal quantization noise. The calculation assumes linear detection and adequate filtering before sampling and decimation; it does not include a measured receiver or phasemeter noise floor.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:newport_readout}{{3}{12}{Calculated carrier and first-order sideband readout noise for the stated bright-beam operating point. The model uses a $50\,\Omega $ load at $300\,\mathrm K$, $100\,\mathrm {nA}$ dark current, and white fractional intensity noise of $9\times 10^{-9}/\sqrt {\mathrm {Hz}}$, with the two beams' additive intensity noise summed coherently. The assumed current-to-voltage gain at each ADC is $50/\sqrt {3}\,\mathrm {V/A}$, with a $1\,\mathrm V$ full-scale span, 14 bits and $2\,\mathrm {GS/s}$. The ADC curve is ideal quantization noise. The calculation assumes linear detection and adequate filtering before sampling and decimation; it does not include a measured receiver or phasemeter noise floor}{figure.3}{}}
\newlabel{eq:performance_x2}{{24}{12}{}{equation.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {E}Combined Noise Contributions}{12}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Input component spectra before TDI and clock correction. The measured electronic residual and sideband-difference estimator are plotted without smoothing over $0.25\,\mathrm  {mHz}$--$1\,\mathrm  {Hz}$. The calculated carrier and sideband readout use the operating point of Fig.~\ref {fig:newport_readout}, including ideal ADC quantization. The dashed curve is the single-link OMS-plus-acceleration comparison. The separate board-timing contribution is included after propagation in Fig.~\ref {fig:total_tdi2_noise}.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:component_inputs_single_link}{{4}{13}{Input component spectra before TDI and clock correction. The measured electronic residual and sideband-difference estimator are plotted without smoothing over $0.25\,\mathrm {mHz}$--$1\,\mathrm {Hz}$. The calculated carrier and sideband readout use the operating point of Fig.~\ref {fig:newport_readout}, including ideal ADC quantization. The dashed curve is the single-link OMS-plus-acceleration comparison. The separate board-timing contribution is included after propagation in Fig.~\ref {fig:total_tdi2_noise}}{figure.4}{}}
