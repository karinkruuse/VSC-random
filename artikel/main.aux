\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Noise sources in LISA and miniLISA, including the terms in Eqs.~\eqref  {eq:science_carrier}, \eqref  {SB_meas}, \eqref  {eq:testmass_readout}, and \eqref  {eq:reference_readout}, and their treatment in the present analysis. ``Not reproduced'' and ``omitted'' refer to the intended measurement model; they do not imply a noise-free laboratory. Readout numbers compare LISA science-interferometer allocations with the detector-noise predictions of Section~\ref {sec:readout_noise} for $4\,\mathrm  {mW}$ per beam; they are not measured total sensitivities.}}{10}{table.1}\protected@file@percent }
